; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Multiplayer Test"
run/main_scene="res://scenes/UI/LoginScreen.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

MapManager="*res://scripts/Managers/map_manager.gd"
AudioManager="*res://scripts/Managers/audio_manager.gd"
MultiplayerManager="*res://scripts/Managers/multiplayer_manager.gd"
NetworkUtils="*res://scripts/Networking/network_utils.gd"
ChannelManager="*res://scripts/Networking/channel_manager.gd"
ClientManager="*res://scripts/Networking/client_manager.gd"
PlayerManager="*res://scripts/Networking/player_manager.gd"
ServerManager="*res://scripts/Networking/server_manager.gd"
ResourceManager="*res://scripts/Managers/resource_manager.gd"
KeybindManager="*res://scripts/Managers/keybind_manager.gd"
UserConfig="*res://scripts/Managers/user_config.gd"
PartyManager="*res://scripts/Managers/party_manager.gd"
InputManager="*res://scripts/Managers/InputManager.gd"
LogManager="*res://scripts/Managers/LogManager.gd"
ChatManager="*res://scripts/Managers/ChatManager.gd"
NetworkManager="*res://scripts/Networking/network_manager.gd"
SaveManager="*res://scripts/Managers/save_manager.gd"
BotManager="*res://scripts/Bot/bot_manager.gd"
TradeManager="*res://scripts/Trading/trade_manager.gd"
JobAdvancementManager="*res://scripts/Managers/job_advancement_manager.gd"
QuestManager="*res://scripts/Managers/quest_manager.gd"
DailyQuestManager="*res://scripts/Managers/daily_quest_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/resource_editor/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "teal",
"res://resources/": "purple",
"res://scenes/": "yellow",
"res://scripts/": "red"
}

[global_group]

networked_entities=""
Players=""
Enemies=""

