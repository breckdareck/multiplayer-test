# Cloud Deployment Environment Variables

# Use this file when deploying to cloud providers
# Add these as environment variables to your deployment

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gamedb

# Flask Configuration
DATABASE_URL=postgresql://postgres:your_secure_password_here@db:5432/gamedb
FLASK_ENV=production

# Game Client Configuration (for reference)
BACKEND_API_URL=http://your_cloud_server_ip:5000/api
